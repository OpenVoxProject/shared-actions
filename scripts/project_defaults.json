    "acceptance-tests": [
      "acceptance/tests"
    ],
    "beaker-options": {
      "helper":       "acceptance/helper.rb",
      "options_file": "acceptance/options/openvox.rb"
    },
    "os-add": [],
    "vms": [
      {
        "role": "primary",
        "count": 1,
        "cpus": 4,
        "mem_mb": 8192
      },
      {
        "role": "agent",
        "count": 1,
        "cpus": 2,
        "mem_mb": 4096
      }
    ]
  }
}
